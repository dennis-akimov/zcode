# Copy to .env (or run `make env`, which writes one with a random password).

# noVNC login. VNC auth uses only the first 8 characters (RFC 6143 7.2.2); at least 8 required.
VNC_PASSWORD=change-me
# Host port for noVNC; bound to 127.0.0.1 only.
NOVNC_PORT=6080
# Virtual screen size of the desktop.
GEOMETRY=1600x1000
# Image tag. The ZCode version that gets installed is pinned in the Dockerfile (ARG ZCODE_VERSION).
ZCODE_VERSION=3.16.3
